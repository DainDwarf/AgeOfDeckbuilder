{
  "permissions": {
    "allow": [
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Measure-Object *)",
      "PowerShell(Sort-Object *)",
      "PowerShell(Group-Object *)",
      "PowerShell(Format-Table *)",
      "PowerShell(ConvertFrom-Json *)",
      "PowerShell(Write-Output *)",
      "PowerShell(npm run *)",
      "PowerShell(npm test*)",
      "PowerShell(npx vitest*)",
      "PowerShell(npx playwright*)",
      "PowerShell(npx tsc*)",
      "PowerShell(npx biome*)",
      "Skill(intake)",
      "Skill(ship)",
      "Skill(upkeep)",
      "Skill(run)",
      "Artifact"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/todo-lint.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/glossary-lint.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
